<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Laurence Segundo Jr. — Beginner Developer</title>
<meta name="description" content="Portfolio of Laurence Segundo Jr., a beginner developer from Ifugao." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=JetBrains+Mono:wght@400;600&family=Outfit:wght@300;400;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="style.css" />
</head>
<body>
  <!-- Background: Ifugao rice terraces -->
  <svg class="terraces" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 160 Q360 110 720 150 T1440 130 V400 H0Z" fill="#24382a"/>
    <path d="M0 220 Q360 175 720 210 T1440 195 V400 H0Z" fill="#2c4632"/>
    <path d="M0 280 Q360 240 720 270 T1440 255 V400 H0Z" fill="#35553c"/>
    <path d="M0 335 Q360 300 720 325 T1440 315 V400 H0Z" fill="#3f6546"/>
  </svg>

  <header class="topbar">
    <span class="brand">LS<span class="dot">.</span>jr</span>
    <nav class="dots" aria-label="Pages"></nav>
  </header>

  <main class="deck">
    <!-- 1. HOME -->
    <section class="page active" data-title="Home">
      <div class="home">
        <div class="photo-frame">
          <!-- Replace images/me.jpg with your own photo -->
          <img src="images/Me.jpg" onerror="this.onerror=null;this.src='images/me-placeholder.svg'" alt="Photo of Laurence Segundo Jr." />
        </div>
        <div class="home-text">
          <p class="kicker">// hello, world — I'm</p>
          <h1>Laurence<br />Segundo Jr.</h1>
          <p class="role"><span class="caret">&gt;</span> Beginner Developer<span class="blink">_</span></p>
          <ul class="contacts">
            <li>
              <!-- Put your Facebook profile link here -->
              <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3c-2.8 0-4 1.8-4 4.3V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.3-.6.6-.6Z"/></svg>
                <span>Facebook</span>
              </a>
            </li>
            <li>
              <a href="mailto:jrsegundo804@gmail.com" aria-label="Email">
                <svg viewBox="0 0 24 24"><path d="M3 5h18v14H3V5Zm2 2v.5l7 4.5 7-4.5V7H5Zm14 2.9-7 4.5-7-4.5V17h14V9.9Z"/></svg>
                <span>jrsegundo804@gmail.com</span>
              </a>
            </li>
            <li>
                            <a href="tel:+639927695272" aria-label="Phone">
                <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
                <span>0992 769 5272</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 2. PERSONAL INFO -->
    <section class="page" data-title="About Me">
      <div class="card">
        <p class="kicker">// 01 — personal info</p>
        <h2>About Me</h2>
        <dl class="info">
          <div><dt>Name</dt><dd>Laurence Segundo Jr.</dd></div>
          <div><dt>Age</dt><dd>18 years old</dd></div>
          <div><dt>Birthday</dt><dd>September 9, 2008</dd></div>
          <div><dt>From</dt><dd>Ifugao, Philippines</dd></div>
          <div><dt>Email</dt><dd><a href="mailto:jrsegundo804@gmail.com">jrsegundo804@gmail.com</a></dd></div>
        </dl>
        <h3>Things I Love</h3>
        <ul class="tags">
          <li>🎌 Watching anime</li>
          <li>🎮 Playing online games</li>
          <li>💻 Computers &amp; technology</li>
        </ul>
      </div>
    </section>

    <!-- 3. EDUCATIONAL ACHIEVEMENTS -->
    <section class="page" data-title="Education">
      <div class="card">
        <p class="kicker">// 02 — educational achievements</p>
        <h2>Education</h2>
        <div class="school">
          <span class="badge">Graduated</span>
          <h3>Namillangan National High School</h3>
          <p>Senior High School · Grades 11 &amp; 12</p>
        </div>
        <ul class="timeline">
          <li><span class="yr">Grade 11</span><strong>With Honors</strong><p>Recognized for academic excellence.</p></li>
          <li><span class="yr">Grade 12</span><strong>With Honors</strong><p>Kept up strong grades through graduation.</p></li>
        </ul>
      </div>
    </section>

    <!-- 4. OTHER ACHIEVEMENTS -->
    <section class="page" data-title="Achievements">
      <div class="card">
        <p class="kicker">// 03 — other achievements</p>
        <h2>Other Achievements</h2>
        <div class="awards">
          <article>
            <div class="medal">🏆</div>
            <h3>Best in Athlete Award</h3>
            <p>Grade 11 &amp; Grade 12 · Namillangan National High School</p>
          </article>
          <article>
            <div class="medal">🤸</div>
            <h3>CARAA Medalist · Gymnastics</h3>
            <p>Competed in gymnastics at the Cordillera Administrative Region Athletic Association (CARAA) meet, winning medals several times since Grade 4.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- 5. PARENTS -->
    <section class="page" data-title="My Parents">
      <div class="card wide">
        <p class="kicker">// 04 — my parents</p>
        <h2>My Parents</h2>
        <div class="parents">
          <figure>
            <!-- Replace images/father.jpg with your father's photo -->
            <img src="images/Father.jpg" onerror="this.onerror=null;this.src='images/father-placeholder.svg'" alt="Laurence C. Segundo" />
            <figcaption><strong>Laurence C. Segundo</strong><span>Father · Farmer</span></figcaption>
          </figure>
          <figure>
            <!-- Replace images/mother.jpg with your mother's photo -->
            <img src="images/Mother.jpeg" onerror="this.onerror=null;this.src='images/mother-placeholder.svg'" alt="Maricel S. Segundo" />
            <figcaption><strong>Maricel S. Segundo</strong><span>Mother · Government Employee</span></figcaption>
          </figure>
        </div>
        <blockquote>
          “Even though we are not that poor and not that rich, I will always love you. I will finish my studies to give back all of your sacrifices.”
        </blockquote>
      </div>
    </section>
  </main>

  <footer class="controls">
    <button class="btn ghost" id="prev" aria-label="Previous page">← Back</button>
    <span class="counter" id="counter">1 / 5</span>
    <button class="btn" id="next" aria-label="Next page">Next →</button>
  </footer>

  <script src="script.js"></script>
</body>
</html>
